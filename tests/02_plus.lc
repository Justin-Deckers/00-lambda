-------------------------------------------------------------------------------
-- DO NOT MODIFY THIS SEGMENT
-------------------------------------------------------------------------------

let ZERO  = \f x -> x
let ONE   = \f x -> f x
let TWO   = \f x -> f (f x)
let THREE = \f x -> f (f (f x))
let FOUR  = \f x -> f (f (f (f x)))

let INCR  = \n f x -> f (n f x)
let ADD   = \n m -> n INCR m
let MUL   = \n m -> n (ADD m) ZERO


-------------------------------------------------------------------------------
-- YOU SHOULD ONLY MODIFY THE TEXT BELOW, JUST THE PARTS MARKED AS COMMENTS
-------------------------------------------------------------------------------
eval incr_one :
  INCR ONE
  -- (a) fill in your reductions here
  =d> (\n f x -> f (n f x)) ONE
  =b> (\f x -> f (ONE f x))
  =d> (\f x -> f ((\f x -> f x) f x))
  =b> (\f x -> f ((\x -> f x) x))
  =b> (\f x -> f (f x))
  =d> TWO

eval add_one_zero :
  ADD ONE ZERO
  -- (b) fill in your reductions here
  =d> (\n m -> n INCR m) ONE ZERO
  =d> (\n m -> n (\n f x -> f (n f x)) m) ONE ZERO
  =b> (\m -> ONE (\n f x -> f (n f x)) m) ZERO
  =b> ONE (\n f x -> f (n f x)) ZERO
  =d> (\f x -> f x) (\n f x -> f (n f x)) ZERO
  =b> (\x -> (\n f x -> f (n f x)) x) ZERO
  =b> (\n f x -> f (n f x)) ZERO
  =d> (\n f x -> f (n f x)) (\f x -> x)
  =b> \f x -> f ((\f x -> x) f x)
  =b> \f x -> f ((\x -> x) x)
  =b> \f x -> f x  
  =d> ONE

eval add_one_two :
  ADD ONE TWO 
  -- (c) fill in your reductions here
  =d> (\n m -> n INCR m) ONE TWO
  =d> (\n m -> n (\n f x -> f (n f x)) m) ONE TWO
  =b> (\m -> ONE (\n f x -> f (n f x)) m) TWO
  =b> ONE (\n f x -> f (n f x)) TWO
  =d> (\f x -> f x) (\n f x -> f (n f x)) TWO
  =b> (\x -> (\n f x -> f (n f x)) x) TWO
  =b> (\n f x -> f (n f x)) TWO
  =b> (\f x -> f (TWO f x))
  =d> (\f x -> f ((\f x -> f (f x)) f x))
  =b> (\f x -> f ((\x -> f (f x)) x))
  =b> \f x -> f (f (f x))
  =d> THREE