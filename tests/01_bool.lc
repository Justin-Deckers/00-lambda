-------------------------------------------------------------------------------
-- DO NOT MODIFY THIS SEGMENT
-------------------------------------------------------------------------------

let TRUE  = \x y -> x
let FALSE = \x y -> y
let ITE   = \b x y -> b x y
let NOT   = \b x y -> b y x
let AND   = \b1 b2 -> ITE b1 b2 FALSE
let OR    = \b1 b2 -> ITE b1 TRUE b2

-------------------------------------------------------------------------------
-- YOU SHOULD ONLY MODIFY THE TEXT BELOW, JUST THE PARTS MARKED AS COMMENTS
-------------------------------------------------------------------------------

eval not_false :
  -- (a) fill in your reductions here
  NOT FALSE
  =d> (\b x y -> b y x) FALSE
  =b> (\x y -> FALSE y x)
  =d> (\x y -> (\x y -> y) y x)
  =b> (\x y -> (\y -> y) x)
  =b> (\x y -> x)
  =d> TRUE
  
eval and_false_true:
  AND FALSE TRUE
  -- (b) fill in your reductions here
  =d> (\b1 b2 -> ITE b1 b2 FALSE) FALSE TRUE
  =d> (\b1 b2 -> (\b x y -> b x y) b1 b2 FALSE) FALSE TRUE
  =b> (\b2 -> (\b x y -> b x y) FALSE b2 FALSE) TRUE
  =b> ((\b x y -> b x y) FALSE TRUE FALSE)
  =b> ((\x y -> FALSE x y) TRUE FALSE)
  =d> ((\x y -> (\x y -> y) x y) TRUE FALSE)
  =b> ((\x y -> (\y -> y) y) TRUE FALSE)
  =b> (\x y -> y) TRUE FALSE
  =b> (\y -> y) FALSE
  =b> FALSE
  =d> FALSE

eval or_true_false :
  OR TRUE FALSE
  -- (c) fill in your reductions here
  =d> (\b1 b2 -> ITE b1 TRUE b2) TRUE FALSE
  =d> (\b1 b2 -> (\b x y -> b x y) b1 TRUE b2) TRUE FALSE
  =b> (\b2 -> (\b x y -> b x y) TRUE TRUE b2)  FALSE
  =b> (\b x y -> b x y) TRUE TRUE FALSE
  =b> (\x y -> TRUE x y) TRUE FALSE
  =b> (\y -> TRUE TRUE y) FALSE
  =b> TRUE TRUE FALSE
  =d> (\x y -> x) TRUE FALSE
  =b> (\y -> TRUE) FALSE
  =b> TRUE
  =d> TRUE